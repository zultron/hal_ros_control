<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
      name="rrbot_system_multi_interface"
      params="name prefix position_only:=^|false with_sensor:=^|false">

    <ros2_control name="${name}" type="system">

      <hardware>
        <plugin>hal_hw_interface/HalSystemInterface</plugin>
      </hardware>

      <joint name="joint1">
        <command_interface name="position">
          <param name="min">-1</param>
          <param name="max">1</param>
        </command_interface>
        <state_interface name="position"/>
        <xacro:unless value="${position_only}">
          <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="acceleration"/>
          </xacro:unless>
      </joint>
      <joint name="joint2">
        <command_interface name="position">
          <param name="min">-1</param>
          <param name="max">1</param>
        </command_interface>
        <state_interface name="position"/>
        <xacro:unless value="${position_only}">
          <command_interface name="velocity">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <command_interface name="acceleration">
            <param name="min">-1</param>
            <param name="max">1</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="acceleration"/>
        </xacro:unless>
      </joint>
      <xacro:if value="${with_sensor}">
        <sensor name="tcp_fts_sensor">
          <state_interface name="force.x"/>
          <state_interface name="torque.z"/>
          <param name="frame_id">tool_link</param>
          <param name="fx_range">100</param>
          <param name="tz_range">15</param>
        </sensor>
      </xacro:if>
    </ros2_control>

  </xacro:macro>

</robot>
